# tg-baidu Environment Variables Example

# Telegram Configuration
TG_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TG_ALLOWED_USER_IDS=123456789,987654321
TG_ADMIN_USER_ID=123456789

# TMDB Configuration
TMDB_API_KEY=YOUR_TMDB_API_KEY
TMDB_LANGUAGE=zh-CN

# Baidu Netdisk Open Platform Configuration
BAIDU_APP_KEY=YOUR_BAIDU_APP_KEY
BAIDU_APP_SECRET=YOUR_BAIDU_APP_SECRET
BAIDU_REDIRECT_URI=oob
BAIDU_ACCESS_TOKEN=
BAIDU_REFRESH_TOKEN=
BAIDU_BDUSS=
BAIDU_STOKEN=

# Media Storage Directories (in Baidu Netdisk)
MEDIA_MOVIE_DIR=/Media/Movies
MEDIA_TV_DIR=/Media/TV
MEDIA_DEFAULT_DIR=/Media/Others

# System
SYSTEM_DATABASE_PATH=data/tg_baidu.db
SYSTEM_LOG_LEVEL=INFO

# Web Dashboard
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_AUTH_PASSWORD=
